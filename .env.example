# ==============================================================================
# SYNORA TECHNOLOGIES PRIVATE LIMITED - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file provides placeholder values and documentation for all supported
# environment variables. Copy this file to .env.local for local development.
# NEVER commit real API keys or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL DOMAIN & HOSTING
# ------------------------------------------------------------------------------
# The canonical public URL used for metadata, OpenGraph tags, and sitemaps.
NEXT_PUBLIC_SITE_URL="https://synoratech.in"

# ------------------------------------------------------------------------------
# 2. CONTACT FORM & EMAIL DISPATCH
# ------------------------------------------------------------------------------
# Inquiries submitted on /contact are dispatched via email.
# To enable email transmission, configure either Option A (Resend) or Option B (SMTP).
# If neither is configured, the contact API gracefully informs the user/administrator
# that the delivery service is pending configuration, preventing silent message loss.

# Option A: Resend API (Recommended for Vercel/Serverless)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=""

# Verified sender address configured on your DNS (e.g., inquiries@synoratech.in)
CONTACT_EMAIL_FROM="inquiries@synoratech.in"

# Internal destination inbox where customer inquiries should be delivered
CONTACT_EMAIL_TO="sales@synoratech.in"

# Option B: Standard Enterprise SMTP (Alternative)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"

# ------------------------------------------------------------------------------
# 3. RATE LIMITING & SECURITY (OPTIONAL)
# ------------------------------------------------------------------------------
# Max inquiries allowed per IP window (default: 5 submissions per 15 minutes)
CONTACT_RATE_LIMIT_MAX="5"
CONTACT_RATE_LIMIT_WINDOW_MS="900000"
